{
  "manifest_version": "0.2",
  "name": "toolbench-mcp",
  "version": "0.3.0",
  "description": "FastMCP 3.1: Arcade ToolBench helper (links, rescoring, bundled Playwright scraper, Iron Shell webapp).",
  "author": { "name": "Sandra Schieder" },
  "server": {
    "type": "python",
    "entry_point": "src/toolbench_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","toolbench_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "health", "description": "health" },
    { "name": "root", "description": "root" },
    { "name": "capabilities", "description": "capabilities" },
    { "name": "logs_query", "description": "logs_query" },
    { "name": "logs_stats", "description": "logs_stats" },
    { "name": "logs_export", "description": "logs_export" },
    { "name": "logs_clear", "description": "logs_clear" },
    { "name": "tools", "description": "tools" },
    { "name": "local_llm_status", "description": "local_llm_status" },
    { "name": "status", "description": "status" },
    { "name": "discover", "description": "discover" },
    { "name": "scrape_urls", "description": "scrape_urls" },
    { "name": "full_run", "description": "full_run" },
    { "name": "tree", "description": "tree" },
    { "name": "read_file", "description": "read_file" },
    { "name": "clear_output", "description": "clear_output" },
    { "name": "toolbench_guide", "description": "toolbench_guide" }
  ]
}
